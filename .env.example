# Optional OpenAI-compatible upstream. Empty means deterministic local mock.
SENTINEL_POLICY=/app/policies/default-strict.yaml
SENTINEL_UPSTREAM_URL=
SENTINEL_UPSTREAM_API_KEY=

# Optional local/dev HS256 issuer key. Production-recommended policy uses OIDC.
SENTINEL_JWT_SECRET=
SENTINEL_OIDC_JWKS_URL=
SENTINEL_OIDC_ISSUER=
SENTINEL_OIDC_AUDIENCE=

# Separate key used by the trusted HITL approval service and gateway verifier.
SENTINEL_APPROVAL_SECRET=
SENTINEL_APPROVAL_REPLAY_DB=.sentinel/approval-replays.sqlite3

# Shared state for multi-worker / multi-replica deployments (use TLS Redis remotely).
SENTINEL_APPROVAL_REPLAY_REDIS_URL=
SENTINEL_RATE_LIMIT_REDIS_URL=

# Ed25519 raw 32-byte seed/public key encoded with standard base64.
# Keep the private signing key in CI or an external signer; deploy only the public key.
SENTINEL_POLICY_SIGNING_KEY=
SENTINEL_POLICY_VERIFY_KEY=

# Optional Chroma server integration. Store tenant_id in every record's metadata.
SENTINEL_CHROMA_URL=
SENTINEL_CHROMA_TOKEN=
SENTINEL_CHROMA_TENANT=default_tenant
SENTINEL_CHROMA_DATABASE=default_database
SENTINEL_CHROMA_COLLECTION=llmsentinel-documents

# Optional MCP tools; map only approved tool names to fixed Streamable HTTP endpoints.
SENTINEL_MCP_TOOL_ENDPOINTS={}
SENTINEL_MCP_TOOL_TOKENS={}

# Optional OTLP/HTTP collector. Remote collectors must use HTTPS.
OTEL_SERVICE_NAME=llmsentinel-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Dashboard gateway URL; use HTTPS outside loopback development.
SENTINEL_API_URL=http://localhost:8000

# Persistent local audit file path.
SENTINEL_AUDIT_PATH=.sentinel/audit.jsonl
SENTINEL_CONTROL_DB=.sentinel/control-plane.sqlite3
SENTINEL_EVAL_DATASET_PATH=benchmarks/dataset_v1.jsonl

# Optional at-least-once audit delivery; remote destinations require HTTPS and a token.
SENTINEL_SIEM_WEBHOOK_URL=
SENTINEL_SIEM_WEBHOOK_TOKEN=
SENTINEL_SIEM_OUTBOX_RETENTION_DAYS=30
